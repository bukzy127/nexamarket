# ──────────────────────────────────────────────────────────────
# Pinata (IPFS pinning)
# ──────────────────────────────────────────────────────────────
# Generate in the Pinata dashboard → API Keys → "New Key".
# Required scopes: pinFileToIPFS, unpin. Treat as a server-side secret —
# this MUST NOT be prefixed NEXT_PUBLIC_ (it would leak to the browser).
PINATA_JWT=
# Optional dedicated gateway host. Defaults to gateway.pinata.cloud.
# Example: my-app.mypinata.cloud  (no scheme, no trailing slash)
PINATA_GATEWAY=gateway.pinata.cloud

# ──────────────────────────────────────────────────────────────
# Injective
# ──────────────────────────────────────────────────────────────
# Injective EVM Testnet is free for development.
NEXT_PUBLIC_INJECTIVE_NETWORK=testnet
# Solidity contract address deployed to Injective EVM Testnet (0x...)
NEXT_PUBLIC_MARKETPLACE_CONTRACT=0xcE83e305B26DCD1Bea900e9A4b3D00EC88F417be
INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
