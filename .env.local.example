# ──────────────────────────────────────────────────────────────
# Firebase (client SDK — public values)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firestore REST. Leave empty to use the local .data fallback.
FIREBASE_PROJECT_ID=
FIRESTORE_REST_TOKEN=

# ──────────────────────────────────────────────────────────────
# Injective
# ──────────────────────────────────────────────────────────────
# "mainnet" or "testnet"
NEXT_PUBLIC_INJECTIVE_NETWORK=testnet
# CosmWasm marketplace contract address (inj1…)
NEXT_PUBLIC_MARKETPLACE_CONTRACT=
MARKETPLACE_CONTRACT=
INJECTIVE_LCD_URL=

# ──────────────────────────────────────────────────────────────
# IPFS — choose ONE provider
# ──────────────────────────────────────────────────────────────
# Pinata
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_JWT=
# OR web3.storage
WEB3_STORAGE_TOKEN=
